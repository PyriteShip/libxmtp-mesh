#!/usr/bin/env bash
# Build all 4 ABIs and publish org.xmtp:android:<version> to ~/.m2 for the RN SDK fork.
set -euo pipefail
ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
SDK_ROOT="$ROOT/sdks/android"

"$SDK_ROOT/dev/bindings-local"

cd "$SDK_ROOT"
VERSION="$(grep '^version=' gradle.properties | cut -d= -f2)"
./gradlew --no-daemon :library:testDebugUnitTest :library:publishToMavenLocal

AAR="$HOME/.m2/repository/org/xmtp/android/$VERSION/android-$VERSION.aar"
fail() { echo "publish-mesh-local: $*" >&2; exit 1; }
[[ -f "$AAR" ]] || fail "missing $AAR"

n="$(unzip -l "$AAR" | grep -cE 'jni/(arm64-v8a|armeabi-v7a|x86|x86_64)/libuniffi_xmtpv3\.so$' || true)"
# shellcheck disable=SC2206 # word-splitting is intentional here (mirrors bindings-local)
EXPECTED_ABIS=(${MESH_ABIS:-arm64-v8a armeabi-v7a x86_64 x86})
EXPECTED_N="${#EXPECTED_ABIS[@]}"
[[ "$n" == "$EXPECTED_N" ]] || fail "expected $EXPECTED_N native libraries in the AAR, found $n"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
unzip -q -o "$AAR" classes.jar AndroidManifest.xml -d "$TMP"
# Capture the listing once: with `set -o pipefail`, `unzip -l | grep -q` is racy —
# grep -q exits on the first match and can SIGPIPE unzip before it finishes writing,
# which pipefail then reports as a pipeline failure even though grep matched.
CLASSES_LISTING="$(unzip -l "$TMP/classes.jar")"
grep -q 'uniffi/xmtpv3/FfiMeshNode.class' <<<"$CLASSES_LISTING" || fail "FfiMeshNode missing"
grep -q 'uniffi/xmtpv3/FfiVerifiedPeer.class' <<<"$CLASSES_LISTING" || fail "FfiVerifiedPeer (presence) missing"
grep -q 'org/xmtp/android/library/mesh/MeshRadio.class' <<<"$CLASSES_LISTING" || fail "MeshRadio missing"
grep -q 'org/xmtp/android/library/mesh/MeshNodeFiles.class' <<<"$CLASSES_LISTING" || fail "MeshNodeFiles missing"
grep -q 'org/xmtp/android/library/mesh/MeshForeground.class' <<<"$CLASSES_LISTING" || fail "MeshForeground missing"
grep -q 'org/xmtp/android/library/mesh/IdentityLogCarrier.class' <<<"$CLASSES_LISTING" || fail "IdentityLogCarrier (reset carry) missing"
unzip -q -o "$AAR" jni/arm64-v8a/libuniffi_xmtpv3.so -d "$TMP"
# grep -c on the file itself (no pipe, so no SIGPIPE under pipefail).
[[ "$(grep -a -c 'uniffi_xmtpv3_fn_func_carry_mesh_identity_log' "$TMP/jni/arm64-v8a/libuniffi_xmtpv3.so" || true)" -ge 1 ]] \
  || fail "carry_mesh_identity_log missing from the native library"
grep -q 'org/xmtp/android/library/mesh/MeshIdentityEvents.class' <<<"$CLASSES_LISTING" || fail "MeshIdentityEvents (restore convergence) missing"
grep -q 'org/xmtp/android/library/mesh/MeshRelayState.class' <<<"$CLASSES_LISTING" || fail "MeshRelayState (relay switch) missing"
grep -q 'uniffi/xmtpv3/FfiRelayStats.class' <<<"$CLASSES_LISTING" || fail "FfiRelayStats missing"
grep -q 'uniffi/xmtpv3/FfiMeshStats.class' <<<"$CLASSES_LISTING" || fail "FfiMeshStats (signed sequencing) missing"
grep -q 'uniffi/xmtpv3/FfiPairingRefusal.class' <<<"$CLASSES_LISTING" || fail "FfiPairingRefusal (private discovery) missing"
grep -q 'org/xmtp/android/library/mesh/policy/DialPlanner.class' <<<"$CLASSES_LISTING" || fail "DialPlanner (private discovery radio) missing"
grep -q 'org/xmtp/android/library/mesh/policy/AdvertClock.class' <<<"$CLASSES_LISTING" || fail "AdvertClock (advert rotation) missing"
grep -q 'org/xmtp/android/library/mesh/MeshPairingState.class' <<<"$CLASSES_LISTING" || fail "MeshPairingState (Mesh pairing API) missing"
if grep -q 'org/xmtp/android/library/mesh/MeshIdentity.class' <<<"$CLASSES_LISTING"; then fail "stale MeshIdentity (short id) in the AAR"; fi
for sym in uniffi_xmtpv3_fn_method_ffimeshnode_stream_identity uniffi_xmtpv3_fn_method_ffixmtpclient_mesh_rebase_signature_request uniffi_xmtpv3_fn_method_ffimeshnode_enable_relay uniffi_xmtpv3_fn_method_ffimeshnode_disable_relay uniffi_xmtpv3_fn_method_ffimeshnode_relay_enabled uniffi_xmtpv3_fn_method_ffimeshnode_relay_stats uniffi_xmtpv3_fn_method_ffimeshnode_mesh_stats uniffi_xmtpv3_fn_method_ffimeshnode_set_account_key uniffi_xmtpv3_fn_method_ffimeshnode_advert_state uniffi_xmtpv3_fn_method_ffimeshnode_classify_advert uniffi_xmtpv3_fn_method_ffimeshnode_link_kind uniffi_xmtpv3_fn_method_ffimeshnode_begin_restore_window uniffi_xmtpv3_fn_method_ffimeshnode_forget_contact uniffi_xmtpv3_fn_method_ffimeshnode_pairing_refusals uniffi_xmtpv3_fn_method_ffimeshnode_contacts_version; do
  [[ "$(grep -a -c "$sym" "$TMP/jni/arm64-v8a/libuniffi_xmtpv3.so" || true)" -ge 1 ]] \
    || fail "$sym missing from the native library"
done
grep -q 'BLUETOOTH_SCAN' "$TMP/AndroidManifest.xml" || fail "BLE permissions missing from manifest"
grep -q 'MeshForegroundService' "$TMP/AndroidManifest.xml" || fail "foreground service missing from manifest"

# DESIGN.md §B13: a mesh.10+ AAR must carry signed sequencing; a stale .build/bindings would not.
[[ "$(grep -a -c 'xmtp-mesh-seq-v1:' "$TMP/jni/arm64-v8a/libuniffi_xmtpv3.so" || true)" -ge 1 ]] \
  || fail "signed sequencing (xmtp-mesh-seq-v1) missing from the native library"
[[ "$(grep -a -c 'xmtp-mesh-seq-attest-v1:' "$TMP/jni/arm64-v8a/libuniffi_xmtpv3.so" || true)" -ge 1 ]] \
  || fail "signed sequencing attestations (xmtp-mesh-seq-attest-v1) missing from the native library"
# DESIGN.md §B14.3: a mesh.11 AAR carries the Noise links and the private-discovery symbols in
# every ABI; a stale .build/bindings for any one of them would not.
for abi in "${EXPECTED_ABIS[@]}"; do
  unzip -q -o "$AAR" "jni/$abi/libuniffi_xmtpv3.so" -d "$TMP"
  for needle in xmtp-mesh-link-v1 uniffi_xmtpv3_fn_method_ffimeshnode_forget_contact uniffi_xmtpv3_fn_method_ffimeshnode_pairing_refusals; do
    [[ "$(grep -a -c "$needle" "$TMP/jni/$abi/libuniffi_xmtpv3.so" || true)" -ge 1 ]] \
      || fail "$needle missing from the $abi native library"
  done
done

echo "Published org.xmtp:android:$VERSION -> $AAR"
